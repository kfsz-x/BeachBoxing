#version 300 es
#extension GL_EXT_shader_texture_lod : enable
#extension GL_EXT_shader_framebuffer_fetch : enable

precision highp float;
precision highp int;
uniform 	vec3 _WorldSpaceCameraPos;
uniform 	mediump vec4 _WorldSpaceLightPos0;
uniform 	mediump vec4 unity_SHAr;
uniform 	mediump vec4 unity_SHAg;
uniform 	mediump vec4 unity_SHAb;
uniform 	mediump vec4 unity_SpecCube0_HDR;
uniform 	mediump vec4 _LightColor0;
uniform 	vec4 _BaseColor;
uniform 	float _GridScale;
uniform 	float _Falloff;
uniform 	float _OverlayAmount;
uniform mediump sampler2D _Grid;
uniform highp sampler2D unity_NHxRoughness;
uniform mediump samplerCube unity_SpecCube0;
in highp vec4 vs_TEXCOORD0;
in highp vec4 vs_TEXCOORD1;
in highp vec4 vs_TEXCOORD2;
in mediump vec3 vs_TEXCOORD3;
layout(location = 0) out mediump vec4 SV_Target0;
vec4 u_xlat0;
vec4 u_xlat1;
vec4 u_xlat2;
ivec3 u_xlati2;
vec3 u_xlat3;
ivec3 u_xlati3;
vec4 u_xlat4;
vec3 u_xlat5;
vec3 u_xlat6;
mediump vec3 u_xlat16_7;
mediump vec3 u_xlat16_8;
mediump vec3 u_xlat16_9;
mediump vec3 u_xlat16_10;
float u_xlat12;
float u_xlat23;
float u_xlat33;
float u_xlat34;
mediump float u_xlat16_40;
void main()
{
    u_xlat0.x = vs_TEXCOORD0.z;
    u_xlat0.y = vs_TEXCOORD1.z;
    u_xlat0.z = vs_TEXCOORD2.z;
    u_xlat1.xyz = log2(abs(u_xlat0.xyz));
    u_xlat1.xyz = u_xlat1.xyz * vec3(vec3(_Falloff, _Falloff, _Falloff));
    u_xlat1.xyz = exp2(u_xlat1.xyz);
    u_xlat33 = u_xlat1.y + u_xlat1.x;
    u_xlat33 = u_xlat1.z + u_xlat33;
    u_xlat1.xyz = u_xlat1.xyz / vec3(u_xlat33);
    u_xlati2.xyz = ivec3(uvec3(lessThan(vec4(0.0, 0.0, 0.0, 0.0), u_xlat0.xyzx).xyz) * 0xFFFFFFFFu);
    u_xlati3.xyz = ivec3(uvec3(lessThan(u_xlat0.xyzx, vec4(0.0, 0.0, 0.0, 0.0)).xyz) * 0xFFFFFFFFu);
    u_xlati2.xyz = (-u_xlati2.xyz) + u_xlati3.xyz;
    u_xlat2.xyz = vec3(u_xlati2.xyz);
    u_xlat33 = u_xlat1.y * u_xlat2.y;
    u_xlat33 = max(u_xlat33, 0.0);
    u_xlat2.w = 1.0;
    u_xlat3.z = vs_TEXCOORD2.w;
    u_xlat3.x = vs_TEXCOORD0.w;
    u_xlat3.y = vs_TEXCOORD1.w;
    u_xlat4 = u_xlat3.zyxz * vec4(_GridScale);
    u_xlat5.xyz = (-u_xlat3.xyz) + _WorldSpaceCameraPos.xyz;
    u_xlat3.xy = u_xlat3.xy * vec2(_GridScale);
    u_xlat4 = u_xlat2.xwyw * u_xlat4;
    u_xlat2.xz = u_xlat2.zw * vec2(-1.0, 1.0);
    u_xlat12 = u_xlat1.y * (-u_xlat2.y);
    u_xlat12 = max(u_xlat12, 0.0);
    u_xlat2.xy = u_xlat2.xz * u_xlat3.xy;
    u_xlat2.xyz = texture(_Grid, u_xlat2.xy).xyz;
    u_xlat3.xyz = texture(_Grid, u_xlat4.zw).xyz;
    u_xlat4.xyz = texture(_Grid, u_xlat4.xy).xyz;
    u_xlat6.xyz = vec3(u_xlat33) * u_xlat3.xyz;
    u_xlat4.xyz = u_xlat4.xyz * u_xlat1.xxx + u_xlat6.xyz;
    u_xlat1.xyw = u_xlat3.xyz * vec3(u_xlat12) + u_xlat4.xyz;
    u_xlat1.xyz = u_xlat2.xyz * u_xlat1.zzz + u_xlat1.xyw;
    u_xlat1.xyz = u_xlat1.xyz + vec3(-1.0, -1.0, -1.0);
    u_xlat1.xyz = vec3(vec3(_OverlayAmount, _OverlayAmount, _OverlayAmount)) * u_xlat1.xyz + vec3(1.0, 1.0, 1.0);
    u_xlat1.xyz = u_xlat1.xyz * _BaseColor.xyz;
    u_xlat16_7.xyz = u_xlat1.xyz * vec3(0.959999979, 0.959999979, 0.959999979);
    u_xlat33 = dot(u_xlat0.xyz, u_xlat0.xyz);
    u_xlat33 = inversesqrt(u_xlat33);
    u_xlat0.xyz = vec3(u_xlat33) * u_xlat0.xyz;
    u_xlat1.x = dot(u_xlat5.xyz, u_xlat5.xyz);
    u_xlat1.x = inversesqrt(u_xlat1.x);
    u_xlat1.xyz = u_xlat1.xxx * u_xlat5.xyz;
    u_xlat16_40 = dot((-u_xlat1.xyz), u_xlat0.xyz);
    u_xlat16_40 = u_xlat16_40 + u_xlat16_40;
    u_xlat16_8.xyz = u_xlat0.xyz * (-vec3(u_xlat16_40)) + (-u_xlat1.xyz);
    u_xlat2 = textureLod(unity_SpecCube0, u_xlat16_8.xyz, 6.0);
    u_xlat16_40 = u_xlat2.w + -1.0;
    u_xlat16_40 = unity_SpecCube0_HDR.w * u_xlat16_40 + 1.0;
    u_xlat16_40 = log2(u_xlat16_40);
    u_xlat16_40 = u_xlat16_40 * unity_SpecCube0_HDR.y;
    u_xlat16_40 = exp2(u_xlat16_40);
    u_xlat16_40 = u_xlat16_40 * unity_SpecCube0_HDR.x;
    u_xlat16_8.xyz = u_xlat2.xyz * vec3(u_xlat16_40);
    u_xlat34 = dot(u_xlat1.xyz, u_xlat0.xyz);
    u_xlat2.x = u_xlat34;
    u_xlat2.x = clamp(u_xlat2.x, 0.0, 1.0);
    u_xlat34 = u_xlat34 + u_xlat34;
    u_xlat1.xyz = u_xlat0.xyz * (-vec3(u_xlat34)) + u_xlat1.xyz;
    u_xlat1.x = dot(u_xlat1.xyz, _WorldSpaceLightPos0.xyz);
    u_xlat1.x = u_xlat1.x * u_xlat1.x;
    u_xlat1.x = u_xlat1.x * u_xlat1.x;
    u_xlat16_40 = (-u_xlat2.x) + 1.0;
    u_xlat23 = u_xlat16_40 * u_xlat16_40;
    u_xlat23 = u_xlat16_40 * u_xlat23;
    u_xlat23 = u_xlat16_40 * u_xlat23;
    u_xlat16_40 = u_xlat23 * 2.23517418e-08 + 0.0399999991;
    u_xlat16_8.xyz = vec3(u_xlat16_40) * u_xlat16_8.xyz;
    u_xlat23 = dot(u_xlat0.xyz, _WorldSpaceLightPos0.xyz);
    u_xlat23 = clamp(u_xlat23, 0.0, 1.0);
    u_xlat16_9.xyz = vec3(u_xlat23) * _LightColor0.xyz;
    u_xlat0.w = 1.0;
    u_xlat16_10.x = dot(unity_SHAr, u_xlat0);
    u_xlat16_10.y = dot(unity_SHAg, u_xlat0);
    u_xlat16_10.z = dot(unity_SHAb, u_xlat0);
    u_xlat16_10.xyz = u_xlat16_10.xyz + vs_TEXCOORD3.xyz;
    u_xlat16_10.xyz = max(u_xlat16_10.xyz, vec3(0.0, 0.0, 0.0));
    u_xlat16_8.xyz = u_xlat16_10.xyz * u_xlat16_7.xyz + u_xlat16_8.xyz;
    u_xlat1.y = 1.0;
    u_xlat0.x = texture(unity_NHxRoughness, u_xlat1.xy).x;
    u_xlat16_7.xyz = u_xlat0.xxx * vec3(0.639999986, 0.639999986, 0.639999986) + u_xlat16_7.xyz;
    SV_Target0.xyz = u_xlat16_7.xyz * u_xlat16_9.xyz + u_xlat16_8.xyz;
    SV_Target0.w = 1.0;
    return;
}
